  "version": "0.1.1",
  "author": {
    "name": "fukuda-yuki",
    "url": "https://github.com/fukuda-yuki"
  },
  "repository": "https://github.com/fukuda-yuki/copilot-tips",
  "extensions": {
    "io.github.fukuda-yuki.copilot-tips": {
      "skills": [
        "./skills/copilot-doctor/",
        "./skills/prompt-audit/"
      ]
    }
  }
}
